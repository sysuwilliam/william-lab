---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ReadingProgress from "@components/ReadingProgress.astro";
import { absoluteUrl, siteConfig, withSiteBase } from "../site.config";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  showReadingProgress?: boolean;
}

const basePath = siteConfig.base.replace(/\/$/, "");
const currentPath = Astro.url.pathname;
const defaultCanonicalPath =
  currentPath === basePath || currentPath === `${basePath}/`
    ? "/"
    : currentPath.startsWith(`${basePath}/`)
      ? currentPath.slice(basePath.length)
      : currentPath;

const {
  title = "个人网站",
  description = siteConfig.description,
  canonicalPath = defaultCanonicalPath.startsWith("/") ? defaultCanonicalPath : `/${defaultCanonicalPath}`,
  ogType = "website",
  showReadingProgress = false
} = Astro.props;

const siteTitle = title === "个人网站" ? siteConfig.title : `${title} | ${siteConfig.title}`;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonicalUrl = absoluteUrl(canonicalPath);
const hasGoatCounter = siteConfig.goatCounterCode.trim().length > 0;
const goatCounterUrl = hasGoatCounter ? `https://${siteConfig.goatCounterCode}.goatcounter.com/count` : "";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href={withSiteBase("rss.xml")} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta name="twitter:card" content="summary" />
    <title>{siteTitle}</title>
    {hasGoatCounter && <script data-goatcounter={goatCounterUrl} async src="//gc.zgo.at/count.js"></script>}
  </head>
  <body data-goatcounter-enabled={hasGoatCounter ? "true" : "false"}>
    {showReadingProgress && <ReadingProgress />}
    <Header />
    <main class="site-shell main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const supportsFinePointer = window.matchMedia("(pointer: fine)").matches;
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (supportsFinePointer && !prefersReducedMotion) {
          const targets = document.querySelectorAll(".card, .terminal");

          targets.forEach((target) => {
            let frame = 0;
            let nextX = 0;
            let nextY = 0;

            const updateGlow = () => {
              target.style.setProperty("--glow-x", `${nextX}px`);
              target.style.setProperty("--glow-y", `${nextY}px`);
              target.style.setProperty("--glow-opacity", target.classList.contains("terminal") ? "0.58" : "0.72");
              frame = 0;
            };

            target.addEventListener("pointermove", (event) => {
              const rect = target.getBoundingClientRect();
              nextX = event.clientX - rect.left;
              nextY = event.clientY - rect.top;

              if (!frame) {
                frame = window.requestAnimationFrame(updateGlow);
              }
            });

            target.addEventListener("pointerleave", () => {
              if (frame) {
                window.cancelAnimationFrame(frame);
                frame = 0;
              }

              target.style.setProperty("--glow-opacity", "0");
            });

            target.addEventListener("focusin", () => {
              target.style.setProperty("--glow-x", "50%");
              target.style.setProperty("--glow-y", "50%");
              target.style.setProperty("--glow-opacity", target.classList.contains("terminal") ? "0.48" : "0.62");
            });

            target.addEventListener("focusout", () => {
              target.style.setProperty("--glow-opacity", "0");
            });
          });
        }

        const progressBar = document.querySelector(".reading-progress span");
        if (progressBar && !prefersReducedMotion) {
          const updateProgress = () => {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const progress = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
            progressBar.style.transform = `scaleX(${progress})`;
          };
          updateProgress();
          window.addEventListener("scroll", updateProgress, { passive: true });
          window.addEventListener("resize", updateProgress);
        }

        document.querySelectorAll(".prose pre").forEach((pre) => {
          if (pre.querySelector(".copy-code")) return;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "copy-code";
          button.textContent = "copy";
          button.addEventListener("click", async () => {
            const code = pre.querySelector("code")?.textContent ?? pre.textContent ?? "";
            try {
              await navigator.clipboard.writeText(code.trim());
              button.textContent = "copied";
              window.setTimeout(() => { button.textContent = "copy"; }, 1400);
            } catch {
              button.textContent = "failed";
              window.setTimeout(() => { button.textContent = "copy"; }, 1400);
            }
          });
          pre.append(button);
        });

        const filterRoot = document.querySelector("[data-project-filters]");
        if (filterRoot) {
          const buttons = filterRoot.querySelectorAll("[data-filter]");
          const cards = document.querySelectorAll("[data-project-card]");
          buttons.forEach((button) => {
            button.addEventListener("click", () => {
              const filter = button.getAttribute("data-filter") ?? "all";
              buttons.forEach((item) => item.setAttribute("aria-pressed", item === button ? "true" : "false"));
              cards.forEach((card) => {
                const groups = (card.getAttribute("data-groups") ?? "").split(" ");
                const visible = filter === "all" || groups.includes(filter);
                card.toggleAttribute("hidden", !visible);
              });
            });
          });
        }

        const formatCount = (count) => {
          const numeric = Number(String(count ?? "0").replace(/[^\d]/g, ""));
          if (!Number.isFinite(numeric)) return String(count ?? "0");
          if (numeric >= 1000000) return `${(numeric / 1000000).toFixed(1).replace(/\.0$/, "")}m`;
          if (numeric >= 1000) return `${(numeric / 1000).toFixed(1).replace(/\.0$/, "")}k`;
          return String(numeric);
        };

        const fetchCounter = (code, path) => {
          const endpoint = `https://${code}.goatcounter.com/counter/${encodeURIComponent(path)}.json`;
          return fetch(endpoint, { cache: "no-store" })
            .then((response) => {
              if (!response.ok) throw new Error(`counter ${response.status}`);
              return response.json();
            })
            .then((data) => data.count || "0");
        };

        document.querySelectorAll("[data-visit-counter]").forEach((counter) => {
          const enabled = counter.getAttribute("data-counter-enabled") === "true";
          const code = counter.getAttribute("data-counter-code") || "";
          const path = counter.getAttribute("data-counter-path") || "TOTAL";
          const value = counter.querySelector("[data-visit-counter-value]");

          if (!value || !enabled || !code) return;

          fetchCounter(code, path)
            .then((count) => {
              value.textContent = formatCount(count);
              counter.setAttribute("data-counter-loaded", "true");
            })
            .catch((error) => {
              value.textContent = String(error).includes("403") ? "stats private" : "stats pending";
              counter.setAttribute("data-counter-loaded", "false");
            });
        });

        const sendGoatEvent = (payload, retries = 20) => {
          if (window.goatcounter?.count) {
            window.goatcounter.count(payload);
            return;
          }

          if (retries <= 0) return;
          window.setTimeout(() => sendGoatEvent(payload, retries - 1), 150);
        };

        document.querySelectorAll("[data-like-counter]").forEach((counter) => {
          const enabled = counter.getAttribute("data-counter-enabled") === "true";
          const interactive = counter.getAttribute("data-like-interactive") === "true";
          const code = counter.getAttribute("data-counter-code") || "";
          const path = counter.getAttribute("data-like-path") || "";
          const value = counter.querySelector("[data-like-counter-value]");
          const storageKey = `william-lab-liked:${path}`;

          if (!value || !enabled || !code || !path) return;

          const setLiked = () => {
            counter.setAttribute("data-liked", "true");
            if (interactive) counter.setAttribute("aria-label", "Liked");
          };

          if (window.localStorage.getItem(storageKey) === "true") setLiked();

          fetchCounter(code, path)
            .then((count) => {
              value.textContent = formatCount(count);
              counter.setAttribute("data-counter-loaded", "true");
            })
            .catch(() => {
              value.textContent = "pending";
              counter.setAttribute("data-counter-loaded", "false");
            });

          if (!interactive) return;

          counter.removeAttribute("disabled");
          counter.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();

            if (counter.getAttribute("data-liked") === "true") return;

            const current = Number((value.textContent || "0").replace(/[^\d]/g, "")) || 0;
            value.textContent = formatCount(current + 1);
            setLiked();
            window.localStorage.setItem(storageKey, "true");

            sendGoatEvent({
              path,
              title: `Like ${document.title}`,
              event: true
            });
          });
        });
      })();
    </script>
  </body>
</html>
