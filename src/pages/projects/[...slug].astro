---
import { getCollection, render } from "astro:content";
import ContentLayout from "@layouts/ContentLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const isPrivateProject = project.data.private || project.data.tags.includes("private");
---

<ContentLayout
  title={project.data.title}
  description={project.data.description}
  date={project.data.date}
  tags={project.data.tags}
  canonicalPath={`/projects/${project.id}/`}
>
  <div class="card content-meta-card project-brief">
    <div class="content-meta-grid">
      <p>
        <strong>Status</strong>
        <span class={`status ${project.data.status}`}>{project.data.status}</span>
      </p>
      <p>
        <strong>Visibility</strong>
        <span>{isPrivateProject ? "private" : "public repo"}</span>
      </p>
      <p>
        <strong>Role</strong>
        <span>{project.data.role ?? (project.data.team ? "team" : "solo")}</span>
      </p>
      <p>
        <strong>Stack</strong>
        <span>{project.data.stack.join(" / ")}</span>
      </p>
    </div>
    {!isPrivateProject && (
      <div class="content-action-row">
        <a class="button primary" href={project.data.repo}>repository</a>
        {project.data.homepage && <a class="button" href={project.data.homepage}>homepage</a>}
      </div>
    )}
  </div>
  <Content />
</ContentLayout>
