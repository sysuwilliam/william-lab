---
import { getCollection, render } from "astro:content";
import ContentLayout from "@layouts/ContentLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const isPrivateProject = project.data.private || project.data.tags.includes("private");
---

<ContentLayout
  title={project.data.title}
  description={project.data.description}
  date={project.data.date}
  tags={project.data.tags}
  canonicalPath={`/projects/${project.id}/`}
>
  <div class="card">
    {isPrivateProject ? (
      <p><strong>Visibility:</strong> <span class="status archived">private</span></p>
    ) : (
      <p><strong>Repository:</strong> <a href={project.data.repo}>{project.data.repo}</a></p>
    )}
    {!isPrivateProject && project.data.homepage && <p><strong>Homepage:</strong> <a href={project.data.homepage}>{project.data.homepage}</a></p>}
    <p><strong>Status:</strong> <span class={`status ${project.data.status}`}>{project.data.status}</span></p>
  </div>
  <Content />
</ContentLayout>
