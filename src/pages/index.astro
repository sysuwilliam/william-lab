---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import TerminalPanel from "@components/TerminalPanel.astro";
import VisitCounter from "@components/VisitCounter.astro";
import { siteConfig } from "../site.config";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const allResources = await getCollection("resources", ({ data }) => !data.draft);

const isPrivateProject = (project: (typeof allProjects)[number]) => project.data.private || project.data.tags.includes("private");
const publicProjects = allProjects.filter((project) => !project.data.team && !isPrivateProject(project));
const projects = [...publicProjects]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const teamProjects = [...allProjects]
  .filter((project) => project.data.team)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const resources = [...allResources]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const seriesSlug = (articleId: string) => articleId.split("/")[0];
const seriesMap = new Map<string, { slug: string; title: string; board: string; description: string; tags: string[]; articles: typeof allArticles }>();

for (const article of allArticles) {
  if (!article.data.series) continue;
  const slug = seriesSlug(article.id);
  const existing = seriesMap.get(slug);
  if (existing) {
    existing.articles.push(article);
    for (const tag of article.data.tags) {
      if (!existing.tags.includes(tag)) existing.tags.push(tag);
    }
    continue;
  }
  seriesMap.set(slug, {
    slug,
    title: article.data.series,
    board: article.data.board ?? article.data.series,
    description: article.data.description,
    tags: [...article.data.tags],
    articles: [article]
  });
}

const seriesList = [...seriesMap.values()].map((series) => ({
  ...series,
  latestDate: Math.max(...series.articles.map((article) => article.data.date.valueOf()))
})).sort((a, b) => {
  const priority = ["arduino-uno-q-4gb", "frdm-mcxn947", "ra4m2-sensor"];
  const aIndex = priority.indexOf(a.slug);
  const bIndex = priority.indexOf(b.slug);
  return (aIndex === -1 ? priority.length : aIndex) - (bIndex === -1 ? priority.length : bIndex);
});

const featuredArticles = [...allArticles]
  .filter((article) => article.data.cover)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const urlFor = (section: string, id: string) => withBase(`${section}/${id}/`);
const resourceUrl = (url: string) => url.startsWith("/") ? withBase(url) : url;
---

<BaseLayout title="个人网站" description={siteConfig.description} canonicalPath="/">
  <section class="hero">
    <div>
      <p class="eyebrow reveal" style="--delay: 0ms">~/public-notes</p>
      <h1 class="reveal" style="--delay: 70ms">William Lab</h1>
      <p class="lead reveal" style="--delay: 140ms">
        一个面向机器人开发、视觉部署、嵌入式和工程复盘的公开笔记。
        这里展示我正在做的项目、可复现的文章记录，以及能继续追踪的资源入口。
        <br />
        邮箱：dengjj28@mail2.sysu.edu.cn
        <br />
        GitHub：github.com/sysuwilliam
      </p>
      <div class="hero-actions reveal" style="--delay: 210ms">
        <a class="button primary" href={withBase("articles/")}>latest notes</a>
        <a class="button" href={withBase("projects/")}>view projects</a>
        <a class="button" href="https://github.com/sysuwilliam">github</a>
      </div>
      <div class="hero-metrics reveal" style="--delay: 250ms">
        <VisitCounter />
      </div>
    </div>
    <div class="hero-terminal reveal" style="--delay: 280ms">
      <TerminalPanel title="profile.session" />
    </div>
  </section>

  {featuredArticles.length > 0 && (
    <section class="section compact-section">
      <div class="section-head">
        <div>
          <p class="eyebrow">field notes</p>
          <h2>近期工程记录</h2>
        </div>
        <a class="button" href={withBase("articles/")}>article index</a>
      </div>
      <div class="grid media-grid">
        {featuredArticles.map((article) => (
          <a class="card media-card" href={urlFor("articles", article.id)}>
            <img
              src={withBase(article.data.cover ?? "")}
              alt={article.data.coverAlt ?? article.data.title}
              loading="lazy"
              decoding="async"
            />
            <div class="media-card-body">
              <span class="resource-kind">{article.data.series ?? "notes"}</span>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
              <div class="card-meta">
                <span class="tag">{article.data.date.toLocaleDateString("zh-CN")}</span>
                {article.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {teamProjects.length > 0 && (
    <section class="section">
      <div class="section-head">
        <div>
          <p class="eyebrow">team project</p>
          <h2>团队项目</h2>
        </div>
        <a class="button" href={withBase("projects/")}>project index</a>
      </div>
      <div class="list-grid">
        {teamProjects.map((project) => (
          <a class="card feature-card" href={urlFor("projects", project.id)}>
            <div>
              <span class="resource-kind">{project.data.role ?? "team"}</span>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
            </div>
            <div class="card-meta">
              <span class="tag">{project.data.date.toLocaleDateString("zh-CN")}</span>
              <span class={`status ${project.data.status}`}>{project.data.status}</span>
              {project.data.stack.map((item) => <span class="tag">{item}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">board series</p>
        <h2>开发板专栏</h2>
      </div>
      <a class="button" href={withBase("articles/")}>all articles</a>
    </div>
    <div class="grid series-grid">
      {seriesList.map((series) => (
        <a class="card series-card" href={withBase(`articles/series/${series.slug}/`)}>
          <span class="resource-kind">{series.board}</span>
          <h3>{series.title}</h3>
          <p>{series.description}</p>
          <div class="card-meta">
            <span class="tag">{series.articles.length} articles</span>
            <span class="tag">updated {new Date(series.latestDate).toLocaleDateString("zh-CN")}</span>
            {series.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">projects</p>
        <h2>个人项目</h2>
      </div>
      <a class="button" href={withBase("projects/")}>all projects</a>
    </div>
    <div class="grid">
      {projects.map((project) => (
        <a class="card" href={urlFor("projects", project.id)}>
          <h3>{project.data.title}</h3>
          <p>{project.data.description}</p>
          <div class="card-meta">
            <span class="tag">{project.data.date.toLocaleDateString("zh-CN")}</span>
            <span class={`status ${project.data.status}`}>{project.data.status}</span>
            {project.data.stack.slice(0, 3).map((item) => <span class="tag">{item}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">resources</p>
        <h2>资源入口</h2>
        <p>整理公开资料、仓库入口和开发板专栏索引，保持站点轻量可维护。</p>
      </div>
      <a class="button" href={withBase("resources/")}>all resources</a>
    </div>
    <div class="list-grid">
      {resources.map((resource) => (
        <a class="card resource-row" href={resourceUrl(resource.data.url)}>
          <div>
            <span class="resource-kind">{resource.data.kind}</span>
            <h3>{resource.data.title}</h3>
            <p>{resource.data.description}</p>
          </div>
          <span class="tag">{resource.data.size ?? "external"}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
