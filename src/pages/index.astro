---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import TerminalPanel from "@components/TerminalPanel.astro";
import StatsPanel from "@components/StatsPanel.astro";
import { siteConfig } from "../site.config";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const allResources = await getCollection("resources", ({ data }) => !data.draft);

const articles = [...allArticles]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const isPrivateProject = (project: (typeof allProjects)[number]) => project.data.private || project.data.tags.includes("private");
const projects = [...allProjects]
  .filter((project) => !project.data.team && !isPrivateProject(project))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const teamProjects = [...allProjects]
  .filter((project) => project.data.team)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 1);

const resources = [...allResources]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const seriesCount = new Set(allArticles.map((article) => article.data.series).filter(Boolean)).size;
const publicProjectCount = allProjects.filter((project) => !project.data.team && !isPrivateProject(project)).length;
const privateProjectCount = allProjects.filter(isPrivateProject).length;
const teamProjectCount = allProjects.filter((project) => project.data.team).length;
const stats = [
  { label: "articles", value: allArticles.length, tone: "accent" },
  { label: "series", value: seriesCount, tone: "blue" },
  { label: "public.repos", value: publicProjectCount },
  { label: "private.notes", value: privateProjectCount },
  { label: "team", value: teamProjectCount },
  { label: "views", value: siteConfig.goatCounterCode ? "loading" : "stats pending", tone: "muted" },
  { label: "latest.commit", value: siteConfig.latestCommit, tone: "blue" }
];

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const urlFor = (section: string, id: string) => withBase(`${section}/${id}/`);
const resourceUrl = (url: string) => url.startsWith("/") ? withBase(url) : url;
---

<BaseLayout title="个人网站" description={siteConfig.description} canonicalPath="/">
  <section class="hero">
    <div>
      <p class="eyebrow reveal" style="--delay: 0ms">~/public-notes</p>
      <h1 class="reveal" style="--delay: 70ms"><span>William</span><span>Lab</span></h1>
      <p class="lead reveal" style="--delay: 140ms">
        这里整理开发板实验、嵌入式链路、视觉部署和公开 GitHub 项目。
        内容以工程报告为主，尽量保留环境、命令、踩坑和验证结论。
      </p>
      <div class="hero-actions reveal" style="--delay: 210ms">
        <a class="button primary" href={withBase("articles/")}>read articles</a>
        <a class="button" href={withBase("projects/")}>view projects</a>
        <a class="button" href="https://github.com/sysuwilliam">github</a>
      </div>
    </div>
    <div class="hero-terminal reveal" style="--delay: 280ms">
      <TerminalPanel title="profile.session" />
    </div>
  </section>

  <section class="section compact-section">
    <div class="section-head">
      <div>
        <p class="eyebrow">site status</p>
        <h2>站点状态</h2>
      </div>
    </div>
    <StatsPanel items={stats} />
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">articles</p>
        <h2>开发板笔记</h2>
      </div>
      <a class="button" href={withBase("articles/")}>all articles</a>
    </div>
    <div class="grid">
      {articles.map((article) => (
        <a class="card" href={urlFor("articles", article.id)}>
          <h3>{article.data.title}</h3>
          <p>{article.data.description}</p>
          <div class="card-meta">
            {article.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">projects</p>
        <h2>个人项目</h2>
      </div>
      <a class="button" href={withBase("projects/")}>all projects</a>
    </div>
    <div class="grid">
      {projects.map((project) => (
        <a class="card" href={urlFor("projects", project.id)}>
          <h3>{project.data.title}</h3>
          <p>{project.data.description}</p>
          <div class="card-meta">
            <span class={`status ${project.data.status}`}>{project.data.status}</span>
            {project.data.stack.slice(0, 3).map((item) => <span class="tag">{item}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>

  {teamProjects.length > 0 && (
    <section class="section">
      <div class="section-head">
        <div>
          <p class="eyebrow">team project</p>
          <h2>团队项目</h2>
        </div>
        <a class="button" href={withBase("projects/")}>project index</a>
      </div>
      <div class="list-grid">
        {teamProjects.map((project) => (
          <a class="card feature-card" href={urlFor("projects", project.id)}>
            <div>
              <span class="resource-kind">{project.data.role ?? "team"}</span>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
            </div>
            <div class="card-meta">
              <span class={`status ${project.data.status}`}>{project.data.status}</span>
              {project.data.stack.map((item) => <span class="tag">{item}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">resources</p>
        <h2>资源入口</h2>
        <p>整理公开资料、仓库入口和开发板专栏索引，保持站点轻量可维护。</p>
      </div>
      <a class="button" href={withBase("resources/")}>all resources</a>
    </div>
    <div class="list-grid">
      {resources.map((resource) => (
        <a class="card resource-row" href={resourceUrl(resource.data.url)}>
          <div>
            <span class="resource-kind">{resource.data.kind}</span>
            <h3>{resource.data.title}</h3>
            <p>{resource.data.description}</p>
          </div>
          <span class="tag">{resource.data.size ?? "external"}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
