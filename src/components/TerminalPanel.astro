---
interface Props {
  title?: string;
}

const { title = "session.log" } = Astro.props;
---

<aside class="terminal" aria-label="Profile status terminal">
  <div class="terminal-bar">
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    <span>{title}</span>
  </div>
  <pre class="terminal-body"><span class="scan-line" aria-hidden="true"></span><span class="prompt">$</span> who am i
邓嘉杰

<span class="prompt">$</span> cat focus.txt
embedded systems
software tools
technical writing

<span class="prompt">$</span> uptime
learning in public, shipping notes<span class="cursor" aria-hidden="true"></span></pre>
</aside>
